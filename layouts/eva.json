{
  "id": "root",
  "type": "row",
  "theme": "eva",
  "preview": "layouts/eva.png",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": {
    "image": "mods/eva-chrome/wallpaper.png",
    "fit": "cover"
  },
  "terminal_opacity": 0.55,
  "terminal_padding": [
    12,
    12
  ],
  "divider": {
    "width": 1,
    "color": "#ff6a0066"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "#0f0a189e",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "eva-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "eva-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "eva-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "eva-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "background": "#0f0a189e",
          "content": {
            "mod": "eva-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 10,
          "gap": 10,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 0,
                  "background": "#00000000",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#6b3fa0aa"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "eva-pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "background": "#0f0a18e6",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "eva-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "eva-changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "background": "#0f0a189e",
          "content": {
            "mod": "eva-status"
          }
        }
      ]
    }
  ]
}
